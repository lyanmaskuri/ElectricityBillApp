<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/poppins_regular"
            android:text="ABOUT DEVELOPER"
            android:textColor="@color/textPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView android:text="This user-friendly app is developed to calculate monthly electricity bills efficiently with many features."
            android:textColor="@color/textPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular" />

        <ImageView
            android:id="@+id/about_image"
            android:src="@drawable/profile"
            android:layout_width="150dp"
            android:layout_marginTop="30dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:layout_marginBottom="16dp"
            android:contentDescription="About photo" />

        <TextView android:text="Student Name: PUTERI NUR LYANA BINTI MASKURI"
            android:textColor="@color/textPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular" />

        <TextView android:text="Student ID: 2025111125"
            android:textColor="@color/textPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular" />

        <TextView android:text="Class: CDCS2515A"
            android:textColor="@color/textPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular" />

        <TextView android:text="Course: ICT602 - MOBILE TECHNOLOGY AND DEVELOPMENT"
            android:textColor="@color/textPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular" />

        <TextView
            android:id="@+id/github_link"
            android:text="GitHub Repository"
            android:textColor="@android:color/holo_blue_light"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="openGitHubLink"
            android:fontFamily="@font/poppins_regular" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#2563EB"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="1dp"/>

        <!-- HOW TO USE TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOW TO USE THIS APP"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins_regular"/>

        <!-- STEP 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Select the month from the dropdown menu."
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/poppins_regular"/>

        <!-- STEP 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Enter the electricity usage (kWh)."
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/poppins_regular"/>

        <!-- STEP 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Adjust the rebate percentage using the slider."
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/poppins_regular"/>

        <!-- STEP 4 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Click the CALCULATE button to view the total and final cost."
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/poppins_regular"/>

        <!-- STEP 5 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Click VIEW RECORDS to see saved bills and tap any item for details."
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/poppins_regular"/>

        <TextView android:text="© 2026 Current. All Right Reserved ElectricityBillApp"
            android:textColor="@color/textSecondary"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular" />

    </LinearLayout>
</ScrollView>
